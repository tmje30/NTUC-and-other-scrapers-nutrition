# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
# For GitHub Actions, these same keys go in the repo's Actions secrets instead.

# --- Notion ---
# Create an internal integration at https://www.notion.so/my-integrations, copy
# its token here, then share the databases with it. Reading the Ingredients DB
# is enough for the daily scan; the page's Add button also WRITES a row to the
# grocery list, so the integration needs "Insert content" and the grocery List
# database shared with it too.
NOTION_TOKEN=ntn_xxx

# Database IDs are auto-discovered by the introspect script, but once known you
# can pin them here to skip discovery (optional).
INGREDIENTS_DB_ID=
MEAL_PREP_DB_ID=

# The "grocery List " data source the Add button writes a row to. Unlike the two
# above, this one is NOT discovered — `grocery-list.ts` falls back to a hardcoded
# id belonging to the original author's workspace, so an add in anyone else's
# workspace writes to a database they do not own, or fails.
# Find yours with `npm run introspect`. Leave blank to keep the existing default.
GROCERY_LIST_DS_ID=

# NOTE: the active plan is NOT configured here. It is whatever you tag `Main` in
# Meal prep's `Current Plan` column in Notion.

# --- Claude (macro lookup for "Add to Ingredients") ---
# Only used by the history page's "Add to Ingredients" button, which looks up the
# product's protein/fat/carbs/fibre before writing the Notion row. Roughly 6-7 US
# cents per tap, billed only when you actually use it.
# Unset is a supported state: the row is still created, just without nutrition
# figures, and the workflow's reply tells you to fill them in by hand.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Telegram (digest out, grocery list in) ---
# This project has its own bot (@Grocery69_bot): it sends the daily digest AND
# receives your texted grocery list. Create one via @BotFather, paste its token,
# press Start on it once, then get your chat id from `npm run tg-diag`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Only needed if the INBOX poller (`npm run tg-poll`) must listen on a DIFFERENT
# bot from the one above. Leave blank and the poller uses TELEGRAM_BOT_TOKEN,
# which is the normal setup.
#
# ⚠️ It exists because a Telegram bot can have a webhook OR serve getUpdates,
# never both. Sending the digest through a bot that already has a webhook is
# fine; POLLING one is not — it returns 409 on every call and the chat just looks
# dead. That is what happens on @Big_Notion_Bot, whose webhook is the only
# delivery path of a Notion Worker in another project. Never deleteWebhook on it;
# point this at another bot instead. The chat id never changes — a private chat's
# id is your own user id, the same for every bot. Diagnose with `npm run tg-diag`.
TELEGRAM_INBOX_BOT_TOKEN=

# --- One-tap Add (optional, not deployed — see docs/one-tap-add.md) ---
# Only needed if you deploy the addToGroceryList webhook. Without these the Add
# button uses the GitHub-issue path, which needs no credentials at all.
# GITHUB_TOKEN — fine-grained PAT, this repo, Contents: read/write.
# ADD_TOKEN    — any long random string; the page asks for it once.
GITHUB_TOKEN=
ADD_TOKEN=
