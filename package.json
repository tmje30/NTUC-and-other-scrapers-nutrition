{
  "name": "@notionhq/workers-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "introspect": "tsx src/scripts/introspect.ts",
    "sample": "tsx src/scripts/sample-usage.ts",
    "targets": "tsx src/scripts/plan-targets.ts",
    "fp": "tsx src/scripts/fp-search.ts",
    "fp-deals": "tsx src/scripts/fp-deals.ts",
    "ss": "tsx src/scripts/ss-search.ts",
    "deals": "tsx src/scripts/deals.ts",
    "start": "tsx src/github/main.ts",
    "dry-run": "tsx src/github/main.ts --dry-run",
    "build-site": "tsx src/scripts/build-site.ts",
    "notify": "tsx src/scripts/notify.ts",
    "add": "tsx src/scripts/add-to-list.ts",
    "item-action": "tsx src/scripts/item-action.ts",
    "macro-test": "tsx src/scripts/macro-test.ts",
    "vendor-probe": "tsx src/scripts/vendor-probe.ts",
    "vendor-scan": "tsx src/scripts/vendor-scan.ts",
    "vendor-repair-promo": "tsx src/scripts/vendor-repair-promo.ts",
    "push-ss": "tsx src/scripts/push-shengsiong.ts",
    "ss-on-request": "tsx src/scripts/ss-on-request.ts",
    "scan-request": "tsx src/scripts/file-scan-request.ts",
    "ext:build": "node extension/build.mjs",
    "test": "npm run check:worker && tsx src/tests/run.ts && node relay/worker.test.mjs && tsx ss-worker/scan.test.ts",
    "tg-poll": "tsx src/scripts/tg-poll.ts",
    "tg-handle": "tsx src/scripts/tg-handle.ts",
    "tg-drain": "tsx src/scripts/tg-drain.ts",
    "tg-sweep": "tsx src/scripts/tg-sweep.ts",
    "tg-webhook": "tsx src/scripts/tg-webhook.ts",
    "tg-adopt-state": "tsx src/scripts/tg-adopt-state.ts",
    "tg-diag": "tsx src/scripts/tg-diag.ts",
    "check:worker": "tsc -p ss-worker && tsc -p ss-worker/tsconfig.test.json"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.9.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "@types/node": "^22.9.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.20.6",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@notionhq/client": "^5.23.2",
    "@notionhq/workers": ">=0.0.0",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "ws": "^8.21.1"
  }
}
